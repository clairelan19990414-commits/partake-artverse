[
  // ── SEPTEMICS VERBS (sv1–sv28) ──
  { "id":"sv1",  "word":"permeate",     "pos":"verb",
    "definition":"To spread through every part of something; to saturate or suffuse completely.",
    "example":"A sense of competition permeates the gallery world — even openings feel like auditions.",
    "source":"Septemics: Scale of Permeation" },
  { "id":"sv2",  "word":"subvert",      "pos":"verb",
    "definition":"To undermine or overthrow something from within; to corrupt the foundations of an order.",
    "example":"Street art subverts public space by returning image-making to those without gallery access.",
    "source":"Septemics: Scale of Basic Purposes" },
  { "id":"sv3",  "word":"transcend",    "pos":"verb",
    "definition":"To rise above or go beyond a limit, category, or expectation.",
    "example":"The best criticism transcends its subject — it uses the work to say something about the world.",
    "source":"Septemics: Scale of Basic Purposes" },
  { "id":"sv4",  "word":"succumb",      "pos":"verb",
    "definition":"To yield to a superior force or pressure; to give way and stop resisting.",
    "example":"Many independent platforms eventually succumb to acquisition rather than compete at scale.",
    "source":"Septemics: Scale of Permeation" },
  { "id":"sv5",  "word":"disassociate", "pos":"verb",
    "definition":"To sever a connection or relationship; to withdraw from association.",
    "example":"Critics tried to disassociate post-Internet aesthetics from the market after the bubble burst.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv6",  "word":"disown",       "pos":"verb",
    "definition":"To refuse to acknowledge something as one's own; to repudiate a connection.",
    "example":"Artists often disown early work once a style becomes associated with a discredited movement.",
    "source":"Septemics: Scale of Control" },
  { "id":"sv7",  "word":"equate",       "pos":"verb",
    "definition":"To treat or regard two things as equivalent; to identify one with another.",
    "example":"To equate popularity with quality is the foundational error of the attention economy.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv8",  "word":"differentiate","pos":"verb",
    "definition":"To perceive or mark the distinction between things; to treat separately.",
    "example":"Good criticism differentiates between work that critiques an institution and work that merely decorates it.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv9",  "word":"condone",      "pos":"verb",
    "definition":"To accept or overlook an offense without protest; to implicitly permit by silence.",
    "example":"The art world condoned predatory collecting practices for decades before anyone named them publicly.",
    "source":"Septemics: Scale of Evaluation" },
  { "id":"sv10", "word":"sublimate",    "pos":"verb",
    "definition":"To redirect an instinct or drive toward a more socially acceptable or elevated activity.",
    "example":"Warhol sublimated his obsession with celebrity into a systematic production method.",
    "source":"Septemics: Scale of Sexuality" },
  { "id":"sv11", "word":"align",        "pos":"verb",
    "definition":"To bring into agreement or association; to position oneself alongside a group or cause.",
    "example":"Brands align with artists not out of shared values but out of shared demographics.",
    "source":"Septemics: Scale of Identity" },
  { "id":"sv12", "word":"animate",      "pos":"verb",
    "definition":"To give life, energy, or spirit to something; to make active and dynamic.",
    "example":"A clear thesis animates even the densest theoretical text — without it, the words just sit there.",
    "source":"Septemics: Scale of Spiritual Identity" },
  { "id":"sv13", "word":"duplicate",    "pos":"verb",
    "definition":"To make an exact copy of something; to reproduce with complete fidelity.",
    "example":"The challenge of NFTs is that they duplicate proof of ownership, not the thing itself.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv14", "word":"suppress",     "pos":"verb",
    "definition":"To forcibly prevent something from being known, felt, or expressed.",
    "example":"Platform moderation suppresses not just harmful speech but the uncomfortable truths around it.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sv15", "word":"subjugate",    "pos":"verb",
    "definition":"To bring under complete control or dominance; to conquer and subordinate.",
    "example":"Colonial display practices subjugated non-Western objects by stripping them of cultural context.",
    "source":"Septemics: Scale of Justification" },
  { "id":"sv16", "word":"pervade",      "pos":"verb",
    "definition":"To be present throughout something; to spread through every area.",
    "example":"Cynicism pervades the contemporary art market — everyone suspects the prices are performance.",
    "source":"Septemics: Scale of Permeation" },
  { "id":"sv17", "word":"embrace",      "pos":"verb",
    "definition":"To accept willingly; to take on or include within one's scope.",
    "example":"The institution embraced digital practice only after the market already priced it.",
    "source":"Septemics: Scale of Life Spheres" },
  { "id":"sv18", "word":"reject",       "pos":"verb",
    "definition":"To refuse to accept, believe, or act on something; to repudiate.",
    "example":"The most interesting artists of the 1970s rejected the gallery entirely — only to be absorbed by it posthumously.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv19", "word":"disbelieve",   "pos":"verb",
    "definition":"To refuse to believe; to withhold belief or credence from.",
    "example":"It is easier to disbelieve the structural argument than to confront what it demands of you.",
    "source":"Septemics: Scale of Belief" },
  { "id":"sv20", "word":"associate",    "pos":"verb",
    "definition":"To connect in thought; to bring into relation with something else.",
    "example":"We associate minimalism with rigour, but its gallery form is often just expensive restraint.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv21", "word":"inspire",      "pos":"verb",
    "definition":"To stimulate a creative impulse; to exert an animating influence on someone.",
    "example":"A strong idea can inspire a decade of work — and a weak one can produce a career of empty production.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv22", "word":"establish",    "pos":"verb",
    "definition":"To bring something into being on a firm and permanent basis; to found or institute.",
    "example":"Greenberg established formalism as the dominant critical language of mid-century America.",
    "source":"Septemics: Scale of Human Ability" },
  { "id":"sv23", "word":"transfer",     "pos":"verb",
    "definition":"To move or convey from one place, person, or context to another.",
    "example":"Meaning does not automatically transfer from one cultural context to another — translation is always partial.",
    "source":"Septemics: Scale of Exchange" },
  { "id":"sv24", "word":"collapse",     "pos":"verb",
    "definition":"To fall or cave in suddenly; to break down completely under pressure.",
    "example":"The distinction between art and commerce collapses the moment the artist becomes the brand.",
    "source":"Septemics: Scale of Survival" },
  { "id":"sv25", "word":"survive",      "pos":"verb",
    "definition":"To continue to exist or function despite difficult conditions.",
    "example":"Only the institutional artists survived the 2008 market correction — everyone else had to teach.",
    "source":"Septemics: Scale of Survival" },
  { "id":"sv26", "word":"compare",      "pos":"verb",
    "definition":"To examine for similarities and differences; to set two things against each other.",
    "example":"To compare Koons to Duchamp is not an insult to Duchamp — it reveals the logic connecting them.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv27", "word":"ignore",       "pos":"verb",
    "definition":"To deliberately refrain from noticing or acknowledging; to give no attention to.",
    "example":"The art world ignores its own labour conditions the way the fashion world ignores its supply chains.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sv28", "word":"identify",     "pos":"verb",
    "definition":"To establish the identity of something; to associate closely with a category or person.",
    "example":"To identify with an artist is not the same as understanding their work — parasocial attachment is not criticism.",
    "source":"Septemics: Scale of Thought" },

  // ── SEPTEMICS ADJECTIVES (sa1–sa35) ──
  { "id":"sa1",  "word":"clandestine",   "pos":"adjective",
    "definition":"Carried out in secret, especially for subversive or deceptive purposes; covert.",
    "example":"The CIA's clandestine patronage of Abstract Expressionism was one of the Cold War's stranger operations.",
    "source":"Septemics: Scale of Allegiance" },
  { "id":"sa2",  "word":"facile",        "pos":"adjective",
    "definition":"Appearing neat or comprehensive by ignoring true complexity; superficially smooth.",
    "example":"The 'art is whatever the artist says it is' argument is facile — it refuses to do the work of evaluation.",
    "source":"Septemics: Scale of Scholarship" },
  { "id":"sa3",  "word":"eidetic",       "pos":"adjective",
    "definition":"Relating to the ability to recall images, sounds, or objects with near-perfect accuracy.",
    "example":"Basquiat's eidetic recall of medical diagrams and street symbols gave his work an archival density.",
    "source":"Septemics: Scale of Memory" },
  { "id":"sa4",  "word":"apathetic",     "pos":"adjective",
    "definition":"Showing little interest, concern, or emotion; indifferent and unresponsive.",
    "example":"An apathetic audience is the artist's real enemy — worse than a hostile one, which at least engages.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sa5",  "word":"avid",          "pos":"adjective",
    "definition":"Keenly eager or enthusiastic; having a strong desire for something.",
    "example":"Avid collectors are not always good collectors — appetite is not the same as discernment.",
    "source":"Septemics: Scale of Scholarship" },
  { "id":"sa6",  "word":"tepid",         "pos":"adjective",
    "definition":"Lukewarm; showing little enthusiasm or conviction.",
    "example":"A tepid review is more damaging than a bad one — at least a bad review generates heat.",
    "source":"Septemics: Scale of Politics" },
  { "id":"sa7",  "word":"compulsive",    "pos":"adjective",
    "definition":"Driven by an irresistible urge; resulting from or relating to obsessive behavior.",
    "example":"Compulsive production is confused with productivity — but most of what gets made is not what needed to be made.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sa8",  "word":"sporadic",      "pos":"adjective",
    "definition":"Occurring at irregular intervals; scattered and inconsistent; not continuous.",
    "example":"Sporadic participation in a discourse is not the same as contributing to it.",
    "source":"Septemics: Scale of Memory" },
  { "id":"sa9",  "word":"chronic",       "pos":"adjective",
    "definition":"Persisting for a long time or recurring frequently; habitual and deep-seated.",
    "example":"The art world's chronic underpayment of technical staff is a structural choice, not a budgetary constraint.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sa10", "word":"acute",         "pos":"adjective",
    "definition":"Intense and reaching a crisis rapidly; sharp and severe (opposite of chronic).",
    "example":"The NFT crash was acute — the slop problem is chronic.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sa11", "word":"authentic",     "pos":"adjective",
    "definition":"Worthy of trust or belief; genuinely what it claims to be; reliable.",
    "example":"Authentic practice does not require an audience — but the market has no way to price work made without one.",
    "source":"Septemics: Scale of Politics" },
  { "id":"sa12", "word":"bipartisan",    "pos":"adjective",
    "definition":"Involving cooperation or agreement between parties that usually oppose each other.",
    "example":"Moral panic is often bipartisan — the right and left disagree on which art is dangerous.",
    "source":"Septemics: Scale of Politics" },
  { "id":"sa13", "word":"partisan",      "pos":"adjective",
    "definition":"Strongly and often unreasoningly biased toward one's own party, cause, or group.",
    "example":"Art criticism became partisan when the question shifted from 'is it good' to 'whose side is it on.'",
    "source":"Septemics: Scale of Politics" },
  { "id":"sa14", "word":"metaphysical",  "pos":"adjective",
    "definition":"Relating to abstract concepts beyond the physical world; concerned with ultimate reality.",
    "example":"Rothko's metaphysical ambitions were genuine — he wanted painting to produce a religious experience.",
    "source":"Septemics: Scale of Belief" },
  { "id":"sa15", "word":"rational",      "pos":"adjective",
    "definition":"Based on reason and logic; able to think clearly and sensibly; not driven by emotion.",
    "example":"Pricing in the primary art market is not rational — it is social and relational.",
    "source":"Septemics: Scale of Aberration" },
  { "id":"sa16", "word":"dysfunctional", "pos":"adjective",
    "definition":"Failing to operate normally; seriously impaired in its intended function.",
    "example":"The grant system is dysfunctional — it rewards those who already have institutional support.",
    "source":"Septemics: Scale of Physical Fitness" },
  { "id":"sa17", "word":"nihilistic",    "pos":"adjective",
    "definition":"Holding that life has no meaning or value; rejecting all established moral principles.",
    "example":"Zombie formalism is nihilistic about intention — it suggests that meaning is just a price sticker.",
    "source":"Septemics: Scale of Justification" },
  { "id":"sa18", "word":"indifferent",   "pos":"adjective",
    "definition":"Having no particular interest or concern; neither for nor against; neutral in feeling.",
    "example":"The algorithm is indifferent to quality — it optimizes for time-on-screen.",
    "source":"Septemics: Scale of Government" },
  { "id":"sa19", "word":"delusional",    "pos":"adjective",
    "definition":"Holding false beliefs that are resistant to reason and contrary to reality.",
    "example":"The belief that virality equals impact is not optimism — it is delusional.",
    "source":"Septemics: Scale of Memory" },
  { "id":"sa20", "word":"neurotic",      "pos":"adjective",
    "definition":"Characterized by excessive anxiety, irrational fears, or obsessive thought patterns.",
    "example":"The neurotic relationship to prestige that MFA culture produces is its most lasting damage.",
    "source":"Septemics: Scale of Attack" },
  { "id":"sa21", "word":"suppressive",   "pos":"adjective",
    "definition":"Tending to hold down or abolish; acting to prevent expression or development.",
    "example":"Debt is suppressive of creative risk — you cannot afford to fail when failure costs you income.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sa22", "word":"invincible",    "pos":"adjective",
    "definition":"Impossible to defeat, overcome, or destroy; unconquerable.",
    "example":"No platform is invincible — MySpace was Google before Facebook was MySpace.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sa23", "word":"belligerent",   "pos":"adjective",
    "definition":"Aggressively hostile and confrontational; inclined to start conflicts.",
    "example":"Online discourse has become belligerent — engagement requires performing combat, not thought.",
    "source":"Septemics: Scale of Attack" },
  { "id":"sa24", "word":"cowardly",      "pos":"adjective",
    "definition":"Lacking courage; contemptibly timid in the face of danger or difficulty.",
    "example":"The cowardly curatorial move is to frame everything as a 'conversation' — it sounds open but commits to nothing.",
    "source":"Septemics: Scale of Attack" },
  { "id":"sa25", "word":"suicidal",      "pos":"adjective",
    "definition":"Tending toward self-destruction; ruinous to one's own interests or survival.",
    "example":"Alienating every mainstream audience is not principled — it is suicidal if you want to change anything.",
    "source":"Septemics: Scale of Attack" },
  { "id":"sa26", "word":"ethnocentric",  "pos":"adjective",
    "definition":"Evaluating other cultures by the standards of one's own; placing one's culture at the center.",
    "example":"Western art history is ethnocentric by structure — the canon was built before it considered whether it should be global.",
    "source":"Septemics: Scale of Life Spheres" },
  { "id":"sa27", "word":"anthropocentric","pos":"adjective",
    "definition":"Placing humans at the center of all existence; regarding humankind as the supreme consideration.",
    "example":"Land art's ambition was never fully anthropocentric — some of it genuinely asked what the landscape wanted.",
    "source":"Septemics: Scale of Life Spheres" },
  { "id":"sa28", "word":"intrinsic",     "pos":"adjective",
    "definition":"Belonging to the essential nature of something; inherent, not derived from outside.",
    "example":"The intrinsic value of a work and its market value are measured by completely different instruments.",
    "source":"Septemics: Scale of Justification" },
  { "id":"sa29", "word":"monogamous",    "pos":"adjective",
    "definition":"Maintaining an exclusive attachment to one partner or allegiance; opposed to multiplicity.",
    "example":"The collector who is monogamous about a single artist's work builds a more coherent argument than the dilettante.",
    "source":"Septemics: Scale of Allegiance" },
  { "id":"sa30", "word":"cautious",      "pos":"adjective",
    "definition":"Careful to avoid danger or error; proceeding with prudence and deliberation.",
    "example":"A cautious institution is a slow institution — and slow is often wrong in a fast culture.",
    "source":"Septemics: Scale of Government" },
  { "id":"sa31", "word":"aloof",         "pos":"adjective",
    "definition":"Distant and reserved; not involved or participating; deliberately detached.",
    "example":"The aloof critic signals authority by appearing unmoved — but detachment is not the same as rigour.",
    "source":"Septemics: Scale of Personal Influence" },
  { "id":"sa32", "word":"immemorial",    "pos":"adjective",
    "definition":"Extending back beyond memory or recorded history; ancient beyond any trace.",
    "example":"The gallery's claim to artistic authority rests on traditions of immemorial prestige — most of which are less than 200 years old.",
    "source":"Septemics: Scale of Allegiance" },
  { "id":"sa33", "word":"detrimental",   "pos":"adjective",
    "definition":"Causing harm or damage; injurious; having a negative effect.",
    "example":"Debt is not just stressful — it is detrimental to the kind of sustained creative risk that good work requires.",
    "source":"Septemics: Scale of Allegiance" },
  { "id":"sa34", "word":"vibrant",       "pos":"adjective",
    "definition":"Full of energy, activity, and enthusiasm; pulsating with life.",
    "example":"A vibrant scene does not need an institution — it generates its own infrastructure.",
    "source":"Septemics: Scale of Physical Fitness" },
  { "id":"sa35", "word":"objective",     "pos":"adjective",
    "definition":"Based on facts rather than feelings; not influenced by personal bias; impartial.",
    "example":"There is no objective measure of aesthetic value — which is why the market's price signals feel so authoritative.",
    "source":"Septemics: Scale of Justification" },

  // ── SEPTEMICS NOUNS (sn1–sn55) ──
  { "id":"sn1",  "word":"aberration",    "pos":"noun",
    "definition":"A departure from what is normal, expected, or right; an anomaly or deviation.",
    "example":"The critical consensus treated the 1990s relational aesthetics movement as an aberration — until it became the template.",
    "source":"Septemics: Scale of Aberration" },
  { "id":"sn2",  "word":"cynicism",      "pos":"noun",
    "definition":"A distrust of human sincerity and motives; the belief that self-interest drives all behavior.",
    "example":"Cynicism about the art world is justified — but total cynicism prevents you from seeing what actually matters.",
    "source":"Septemics: Scale of Belief" },
  { "id":"sn3",  "word":"compulsion",    "pos":"noun",
    "definition":"An irresistible urge to perform an act, especially one contrary to one's conscious wishes.",
    "example":"The compulsion to post is not creativity — it is anxiety in the shape of output.",
    "source":"Septemics: Scale of Control" },
  { "id":"sn4",  "word":"enmity",        "pos":"noun",
    "definition":"Deep-seated hostility and ill will; bitter antagonism between parties.",
    "example":"The enmity between the critical left and the market left produced a decade of unreadable art writing.",
    "source":"Septemics: Scale of Relationships" },
  { "id":"sn5",  "word":"allegiance",    "pos":"noun",
    "definition":"Loyal devotion to a person, group, cause, or institution.",
    "example":"Brand allegiance has replaced aesthetic allegiance — people follow artists the way they follow influencers.",
    "source":"Septemics: Scale of Identity" },
  { "id":"sn6",  "word":"belligerence",  "pos":"noun",
    "definition":"Aggressive hostility; a warlike attitude or readiness to attack.",
    "example":"The belligerence of online discourse has made nuance structurally impossible — the platform punishes hesitation.",
    "source":"Septemics: Scale of Attack" },
  { "id":"sn7",  "word":"antipathy",     "pos":"noun",
    "definition":"A deep-seated feeling of dislike or aversion; habitual repugnance toward something.",
    "example":"The critic's antipathy toward decoration masked an unwillingness to distinguish good ornament from bad.",
    "source":"Septemics: Scale of Permeation" },
  { "id":"sn8",  "word":"vendetta",      "pos":"noun",
    "definition":"A prolonged and bitter campaign of hostility or revenge; a sustained feud.",
    "example":"Art world vendettas are unusually durable — the community is small enough for grudges to outlive careers.",
    "source":"Septemics: Scale of Permeation" },
  { "id":"sn9",  "word":"cognoscenti",   "pos":"noun",
    "definition":"People with superior knowledge or expertise in a particular field (Italian; treated as plural).",
    "example":"The cognoscenti recognized Wool's stencil work a decade before the market did.",
    "source":"Septemics: Scale of Thought" },
  { "id":"sn10", "word":"automaticity",  "pos":"noun",
    "definition":"The ability to perform an action without conscious attention; involuntary, conditioned response.",
    "example":"Automaticity in studio practice frees cognitive resources for decisions that actually matter.",
    "source":"Septemics: Scale of Mental Deletion" },
  { "id":"sn11", "word":"stalemate",     "pos":"noun",
    "definition":"A deadlock in which neither side can make progress; a position where no action is possible.",
    "example":"The institutional critique movement reached a stalemate — every critical gesture was eventually absorbed.",
    "source":"Septemics: Scale of Conflict" },
  { "id":"sn12", "word":"ingenuousness", "pos":"noun",
    "definition":"Artless sincerity; freedom from deception or reserve; open, naive candor.",
    "example":"The ingenuousness of early internet art — its belief that free access would democratize everything — now reads as tragic.",
    "source":"Septemics: Scale of Belief" },
  { "id":"sn13", "word":"contrition",    "pos":"noun",
    "definition":"Sincere remorse for wrongdoing; deep penitence and resolve to improve.",
    "example":"Institutional contrition over past exclusions often produces a correction that is itself exclusionary.",
    "source":"Septemics: Scale of Identity" },
  { "id":"sn14", "word":"sublimation",   "pos":"noun",
    "definition":"The redirection of an instinct or drive toward a more socially accepted or elevated goal.",
    "example":"Art-making as sublimation has Freudian roots — but the market converts the sublimated back into currency.",
    "source":"Septemics: Scale of Sexuality" },
  { "id":"sn15", "word":"delusion",      "pos":"noun",
    "definition":"A fixed false belief held despite contrary evidence; persistent self-deception.",
    "example":"The belief that critical acclaim protects against market irrelevance is a delusion specific to MFA culture.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sn16", "word":"oblivion",      "pos":"noun",
    "definition":"The state of being completely forgotten; unconscious unawareness; total erasure from memory.",
    "example":"Most art made in any given year falls into oblivion — which makes the survival of anything a puzzle worth examining.",
    "source":"Septemics: Scale of Identity" },
  { "id":"sn17", "word":"repression",    "pos":"noun",
    "definition":"The unconscious exclusion of painful memories or impulses from conscious awareness.",
    "example":"The field's repression of its own commercial entanglements produces the neurotic language of contemporary art writing.",
    "source":"Septemics: Scale of Memory" },
  { "id":"sn18", "word":"equilibrium",   "pos":"noun",
    "definition":"A state of balance between opposing forces; stable mental or emotional composure.",
    "example":"The artist who can hold commercial and critical pressures in equilibrium is rare — and usually misunderstood.",
    "source":"Septemics: Scale of Conflict" },
  { "id":"sn19", "word":"magnetism",     "pos":"noun",
    "definition":"Compelling personal attractiveness or charisma; the power to draw others without visible effort.",
    "example":"Beuys's magnetism was inseparable from his mythology — the lecture was only half the work.",
    "source":"Septemics: Scale of Communication" },
  { "id":"sn20", "word":"poise",         "pos":"noun",
    "definition":"Dignified, self-assured composure, especially in difficult or public situations.",
    "example":"Poise in a studio visit is an art in itself — knowing when to speak and when to let the work answer.",
    "source":"Septemics: Scale of Communication" },
  { "id":"sn21", "word":"empathy",       "pos":"noun",
    "definition":"The ability to understand and share the feelings of another; vicarious emotional attunement.",
    "example":"Relational aesthetics made empathy the medium — but it also made discomfort optional in a way that limited it.",
    "source":"Septemics: Scale of Permeation" },
  { "id":"sn22", "word":"impartiality",  "pos":"noun",
    "definition":"Freedom from bias or favoritism; equal and fair treatment of all parties.",
    "example":"Institutional impartiality is often a performance — the acquisition committee has preferences it does not name.",
    "source":"Septemics: Scale of Evaluation" },
  { "id":"sn23", "word":"pacifism",      "pos":"noun",
    "definition":"The principled refusal to engage in war or violence; opposition to aggression as policy.",
    "example":"Pacifism as an aesthetic position — refusing confrontation — collapses into decoration.",
    "source":"Septemics: Scale of Attack" },
  { "id":"sn24", "word":"nihilism",      "pos":"noun",
    "definition":"The rejection of all moral principles and belief in the meaninglessness of existence.",
    "example":"Nihilism is not the same as cynicism — nihilism abandons all frameworks, while cynicism just distrusts the existing ones.",
    "source":"Septemics: Scale of Justification" },
  { "id":"sn25", "word":"telepathy",     "pos":"noun",
    "definition":"The supposed direct transmission of thoughts between minds without physical means.",
    "example":"The artist wants telepathy — the viewer who gets it without explanation; the critic usually has to do the translating.",
    "source":"Septemics: Scale of Personal Influence" },
  { "id":"sn26", "word":"unanimity",     "pos":"noun",
    "definition":"Complete agreement among all parties; total consensus without dissent.",
    "example":"Unanimity in a panel discussion is a warning sign — it usually means the uncomfortable questions were not asked.",
    "source":"Septemics: Scale of Evaluation" },
  { "id":"sn27", "word":"idée fixe",     "pos":"noun",
    "definition":"A persistent, dominating idea or obsession that the mind returns to regardless of context.",
    "example":"Troemel's idée fixe is the platform as sculptor — everything else in his practice orbits that central claim.",
    "source":"Septemics: Scale of Justification" },
  { "id":"sn28", "word":"entrapment",    "pos":"noun",
    "definition":"The condition of being caught or confined with no viable exit; ensnarement.",
    "example":"The MFA is a form of entrapment for some — the credential requires debt that then requires a career path that didn't exist.",
    "source":"Septemics: Scale of Stopping" },
  { "id":"sn29", "word":"conformity",    "pos":"noun",
    "definition":"Compliance with prevailing social norms, expectations, or conventions.",
    "example":"Conformity in contemporary art wears the costume of rebellion — everyone is transgressive in the same direction.",
    "source":"Septemics: Scale of Basic Purposes" },
  { "id":"sn30", "word":"collectivism",  "pos":"noun",
    "definition":"The principle that group interests take precedence over individual ones; centralized social organization.",
    "example":"Open-source culture began as collectivism and became the infrastructure for monopoly capital.",
    "source":"Septemics: Scale of Choice" },
  { "id":"sn31", "word":"robotism",      "pos":"noun",
    "definition":"Mechanical, repetitive behavior lacking genuine will or thought; acting as an automaton.",
    "example":"Content scheduling tools produce robotism — the post goes out whether or not you have anything to say.",
    "source":"Septemics: Scale of Choice" },
  { "id":"sn32", "word":"dilettante",    "pos":"noun",
    "definition":"A person who dabbles in a subject without serious depth or commitment; a superficial enthusiast.",
